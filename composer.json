{
    "name": "ptplugins/filament-model-merger-free",
    "description": "Free duplicate-record merger for FilamentPHP. Merge two records side-by-side and transfer their HasMany / HasOne relations, with a built-in merge page and table action.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "filamentphp",
        "laravel",
        "merge",
        "deduplication",
        "eloquent"
    ],
    "homepage": "https://ptplugins.com/filament-model-merger",
    "support": {
        "issues": "https://github.com/ptplugins/filament-model-merger-free/issues",
        "source": "https://github.com/ptplugins/filament-model-merger-free"
    },
    "authors": [
        {
            "name": "Premtech Plugins",
            "email": "mihailo@ptplugins.com",
            "homepage": "https://ptplugins.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/database": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "PtPlugins\\FilamentModelMergerFree\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PtPlugins\\FilamentModelMergerFree\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "illuminate/events": "^11.0 || ^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "PtPlugins\\FilamentModelMergerFree\\ModelMergerFreeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
